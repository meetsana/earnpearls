NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
DATABASE_URL=postgres://earnpearls:earnpearls@127.0.0.1:5432/earnpearls
DATABASE_SSL=false
DATABASE_POOL_MAX=10
APP_ORIGINS=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
TRUST_PROXY=false
SESSION_COOKIE_NAME=ep_session
SESSION_TTL_HOURS=24
AUTH_TOKEN_TTL_MINUTES=30
PASSWORD_PEPPER=replace-with-a-long-random-secret
IP_HASH_SECRET=replace-with-a-different-long-random-secret
# 32 random bytes encoded as base64. Example command: openssl rand -base64 32
DATA_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
PROVIDER_WEBHOOK_SECRET=replace-with-provider-specific-secret-manager-values
ENABLE_SWAGGER=true
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
SEED_ADMIN_COUNTRY=US
ALLOW_DEMO_DATA=false
SMTP_URL=
EMAIL_FROM=EarnPearls <no-reply@example.com>
EMAIL_WORKER_POLL_MS=5000
