{
  "name": "earnpearls",
  "version": "1.0.0",
  "private": true,
  "description": "EarnPearls — Your Time. Your Rewards.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "npm run dev --workspace @earnpearls/api",
    "build": "npm run build:contracts && npm run build:web && npm run build:api",
    "build:web": "npm run typecheck:web && vite build",
    "build:contracts": "npm run build --workspace @earnpearls/contracts",
    "build:api": "npm run build --workspace @earnpearls/api",
    "preview": "vite preview",
    "format": "prettier --write \"apps/api/**/*.ts\" \"packages/contracts/**/*.ts\" \"src/**/*.{ts,tsx}\" \"scripts/*.mjs\" \"{package.json,apps/api/package.json,packages/contracts/package.json,tsconfig.web.json,vite.config.ts,vitest.config.ts}\" \".github/workflows/*.yml\" \"infra/docker-compose.yml\"",
    "format:check": "prettier --check \"apps/api/**/*.ts\" \"packages/contracts/**/*.ts\" \"src/**/*.{ts,tsx}\" \"scripts/*.mjs\" \"{package.json,apps/api/package.json,packages/contracts/package.json,tsconfig.web.json,vite.config.ts,vitest.config.ts}\" \".github/workflows/*.yml\" \"infra/docker-compose.yml\"",
    "typecheck": "npm run typecheck --workspace @earnpearls/contracts && npm run build --workspace @earnpearls/contracts && npm run typecheck:web && npm run typecheck --workspace @earnpearls/api",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "test": "npm run test:web && npm run test --workspace @earnpearls/api",
    "test:web": "vitest run --config vitest.config.ts",
    "check": "npm run format:check && npm run typecheck && npm run test && npm run build && npm run openapi:generate && npm run audit:mvp",
    "audit:mvp": "node scripts/audit-mvp.mjs",
    "db:migrate": "npm run db:migrate --workspace @earnpearls/api",
    "db:seed": "npm run db:seed --workspace @earnpearls/api",
    "openapi:generate": "npm run openapi:generate --workspace @earnpearls/api"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "jest-axe": "^10.0.0",
    "jsdom": "^28.1.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.0"
  },
  "packageManager": "npm@11.9.0"
}
